{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shishu-lottery-lab",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "VAULTS", "class_name": "LotteryVault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LotteryVault"] }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false }
}
